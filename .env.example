#Server Configuration:
PORT=3001
NODE_ENV=development
API_BASE_PATH=/api
CORS_ORIGIN=*

#External APIs:
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_POKEMON_ENDPOINT=/pokemon

#SSL Configuration:
REJECT_UNAUTHORIZED=false

#API Limits:
DEFAULT_LIMIT=20
MAX_LIMIT=100
REQUEST_TIMEOUT=5000

#Health Check:
HEALTH_CHECK_ENDPOINT=/health