{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "POKEAPI_BASE_URL": "https://pokeapi.co/api/v2",
    "POKEAPI_POKEMON_ENDPOINT": "/pokemon",
    "DEFAULT_LIMIT": "20",
    "MAX_LIMIT": "100",
    "REJECT_UNAUTHORIZED": "false"
  }
}
